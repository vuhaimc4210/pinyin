# Copy file này thành ".env" rồi điền thông tin thật.
# KHÔNG commit file .env (đã có trong .gitignore) vì chứa token bí mật.

# Lấy trong trang hồ sơ (profile) speechgen.io, mục "Khóa bí mật"
SPEECHGEN_EMAIL=you@example.com
SPEECHGEN_TOKEN=your_secret_token_here

# KHÔNG dùng "Xiaoxiao Dialects" vì mặc định đọc theo phương ngữ Ngô.
SPEECHGEN_VOICE=Xiaoyin
